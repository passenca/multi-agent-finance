# ===========================================
# Configuração de APIs para Dados Financeiros
# ===========================================

# ALPHA VANTAGE API KEY
# Obter chave gratuita em: https://www.alphavantage.co/support/#api-key
# Gratuito: 25 chamadas/dia
ALPHA_VANTAGE_KEY=your_api_key_here

# FRED API KEY (Federal Reserve Economic Data)
# Obter chave gratuita em: https://fred.stlouisfed.org/docs/api/api_key.html
# Gratuito: 120 requests/minuto
FRED_API_KEY=your_fred_api_key_here

# Copiar este ficheiro para .env e colocar as tuas chaves reais
